# ============================================================
# PORTFOLIO RIFQI ARDIANSYAH - ENVIRONMENT VARIABLES
# Copy file ini menjadi `.env` lalu isi nilainya sesuai kebutuhan.
# File .env terletak di ROOT proyek (folder portfolio/).
# ============================================================

# --- Mode Statis (Netlify) ---
# Aktifkan mode statis: semua data dibaca dari /data/*.json dan edit admin
# disimpan di localStorage browser. Otomatis aktif pada build produksi,
# set true jika ingin memaksa.
VITE_STATIC_MODE=true

# Kredensial admin mode statis (dibaca dari Netlify build env / .env).
# Jika tidak diisi: admin / admin123
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=admin123

# --- Frontend (Vite) ---
# URL API eksternal. Di mode statis JANGAN diisi (biarkan kosong). Isi hanya
# bila memakai backend sendiri, mis. https://api.example.com/api
VITE_API_URL=

# URL situs untuk sitemap.xml, robots.txt, dan SEO JSON-LD.
# Isi dengan domain Netlify, mis. https://rifqi-ardiansyah.netlify.app
VITE_SITE_URL=

# Nama situs (fallback untuk SEO)
VITE_SITE_NAME=Rifqi Ardiansyah - Portfolio

# EmailJS - dipakai untuk form contact
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Backend (Render) ---
# Hanya dibutuhkan saat deploy backend ke Render.
# Cloudinary untuk storage foto yang di-share antar website.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin credentials untuk backend (jika menggunakan backend auth)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# JWT secret untuk token autentikasi admin
JWT_SECRET=

# Git Persistence - commit perubahan data JSON kembali ke GitHub agar tidak hilang saat Render restart
# Set true untuk mengaktifkan, dan pastikan GITHUB_TOKEN di-set di Render
GIT_PERSISTENCE=false
# Buat GitHub Personal Access Token dengan scope 'repo' di https://github.com/settings/tokens
# Kemudian set sebagai environment variable di Render
GITHUB_TOKEN=
