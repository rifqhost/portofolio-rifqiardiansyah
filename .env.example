# ============================================================
# PORTFOLIO RIFQI ARDIANSYAH - ENVIRONMENT VARIABLES
# Copy file ini menjadi `.env` lalu isi nilainya sesuai kebutuhan.
# ============================================================

# --- Server ---
# Port untuk backend Express (dev & production lokal)
PORT=5000

# Secret untuk menandatangani JWT (WAJIB diganti di produksi!)
JWT_SECRET=ganti-dengan-secret-acak-panjang

# Kredensial admin. Jika tidak diisi, nilai dari data/config.json dipakai.
# Default user/password (jika tidak di-set): admin / admin123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Frontend (Vite) ---
# URL API. Default `/api` memakai proxy saat dev & same-origin saat produksi.
VITE_API_URL=/api

# EmailJS - dipakai untuk form contact
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- SEO / PWA ---
VITE_SITE_URL=https://rifqiardiansyah.vercel.app
VITE_SITE_NAME=Rifqi Ardiansyah - Portfolio
